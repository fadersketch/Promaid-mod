    },
    {
      "text": "前方有",
      "file": "ahead_of_you.ogg",
      "mode": "contains"
    },
    {
      "text": "附魔金苹果给你",
      "file": "aid_enchanted_apple.ogg",
      "mode": "contains"
    },
    {
